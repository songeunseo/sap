<mxfile host="app.diagrams.net" modified="2026-09-26T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="dlm-overall" name="전체 프레임워크">
    <mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="650" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DLM pruning 전체 알고리즘 프레임워크" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="1020" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="같은 모델·예산·가중치 순위에서, 무엇을 보존할지 정해 정적 마스크를 배분한다" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#4f5d75;fontFamily=Noto Sans CJK KR;fontSize=17;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="93" width="1180" height="36" as="geometry"/></mxCell>
        <mxCell id="n1" value="① 모델·예산 고정&#xa;&#xa;Dense LLaDA&#xa;Wanda 가중치 순위&#xa;정확한 sparsity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="180" height="180" as="geometry"/></mxCell>
        <mxCell id="n2" value="② 부분 공개 문맥&#xa;&#xa;같은 질문 토큰 고정&#xa;주변 토큰 단계별 공개&#xa;x₀ → x₁ → …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="245" y="170" width="180" height="180" as="geometry"/></mxCell>
        <mxCell id="n3" value="③ 두 모델의 응답&#xa;&#xa;같은 문맥을 Dense와&#xa;Sparse에 입력&#xa;eᵢ = rSparse − rDense" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="180" height="180" as="geometry"/></mxCell>
        <mxCell id="n4" value="④ 보존 목표 계산&#xa;&#xa;A: 각 상태의 오차&#xa;C: 상태 간 변화 오차&#xa;방법별 연결·출력 선택" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbece6;strokeColor=#eb6c36;strokeWidth=2;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="655" y="170" width="180" height="180" as="geometry"/></mxCell>
        <mxCell id="n5" value="⑤ 정적 마스크 배분&#xa;&#xa;블록별 제거량 탐색&#xa;고정 순위에서 선택&#xa;전체 예산 정확히 맞춤" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbece6;strokeColor=#eb6c36;strokeWidth=2;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="860" y="170" width="180" height="180" as="geometry"/></mxCell>
        <mxCell id="n6" value="⑥ 독립 문항 평가&#xa;&#xa;완성된 Sparse 모델&#xa;GSM8K 등 실제 생성&#xa;같은 조건의 기준선 비교" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1065" y="170" width="180" height="180" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=2;endArrow=classic;" edge="1" source="n1" target="n2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=2;endArrow=classic;" edge="1" source="n2" target="n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#eb6c36;strokeWidth=2;endArrow=classic;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#eb6c36;strokeWidth=2;endArrow=classic;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=2;endArrow=classic;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="notes" value="A-only: ④의 A만 사용    |    A+C: A와 C 함께 사용    |    Multi / Short / Path / All: ②의 상태와 ④의 연결 규칙 변경" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2d3142;fontFamily=Noto Sans CJK KR;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="1240" height="40" as="geometry"/></mxCell>
        <mxCell id="notes2" value="Vector: ③의 출력 표현 변경    |    Exchange: ⑤의 탐색 변경    |    Uniform-Wanda: ⑤의 균등 배분 기준선" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#4f5d75;fontFamily=Noto Sans CJK KR;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1240" height="40" as="geometry"/></mxCell>
        <mxCell id="foot" value="설계 흐름도 · 방법별 성능 우열을 뜻하지 않음" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#7a8399;fontFamily=Noto Sans CJK KR;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="900" height="30" as="geometry"/></mxCell>
