        <mxCell id="020" value="e(x) = Sparse 출력 − Dense 출력&#10;A = 평균[e(상태)²]  → 상태 자체를 보존" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#17233D;fontFamily=Noto Sans CJK KR;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
