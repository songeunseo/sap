        <mxCell id="019" value="A = 각 상태의 출력 오차" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#3B6EC9;fontFamily=Noto Sans CJK KR;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
