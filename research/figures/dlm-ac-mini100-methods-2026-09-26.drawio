        <mxCell id="022" value="C = 문맥 변화에 대한 반응 오차" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#B96614;fontFamily=Noto Sans CJK KR;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
